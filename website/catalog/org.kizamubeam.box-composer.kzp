    "es": {
     "name": "Compositor de cajas",
     "desc": "Caja con paredes interiores colocadas libremente: uniones en T, esquinas, extremos libres y cruces. Experimental: corta una prueba de las uniones antes de un trabajo grande.",
     "keys": "caja divisor compartimentos organizador inserto",
     "label": "Compositor de cajas {width} × {depth} × {height}",
     "width": "Ancho",
