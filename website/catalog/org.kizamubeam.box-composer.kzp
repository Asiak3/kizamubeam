   "texts": {
    "en": {
     "name": "Box composer",
     "desc": "Box with freely placed inner walls: T joints, corners, free ends and crossings. Experimental: please test-cut the joints before a large job.",
     "keys": "box divider compartment organizer insert",
     "label": "Box composer {width} × {depth} × {height}",
     "width": "Width",
     "depth": "Depth",
     "height": "Height",
     "thickness": "Material thickness",
     "walls": "Inner walls",
     "wallsRef": "Size the inner walls were placed in",
     "part.floor": "Floor",
     "walls-bad": "The wall list cannot be read.",
     "box-small": "The box is too small for the material thickness.",
     "wall-outside": "Wall {id} lies outside the box.",
     "wall-on-outer": "Wall {id} lies on an outer wall.",
     "wall-near-outer": "Wall {id} is closer than {min} mm to an outer wall.",
     "wall-short": "Wall {id} is shorter than {min} mm.",
     "walls-close": "Walls {id} and {id2} are closer than {min} mm to each other.",
     "wall-gap": "Wall {id} ends less than {min} mm from a wall without touching it.",
     "tees-misaligned": "Walls {id} and {id2} meet the same wall from both sides less than {min} mm apart: line them up or move them further apart.",
     "free-end-short": "The free end of wall {id} is shorter than {min} mm.",
     "info.walls": "Inner walls",
     "wallFront": "Front wall",
     "wallBack": "Back wall",
     "wallLeft": "Left wall",
     "wallRight": "Right wall",
     "lid": "Lid",
     "dividerDrop": "Inner walls lower by",
     "dividerDrop.title": "How much lower the inner walls are than the outer walls",
     "fromMaterial": "From material",
     "fromMaterial.title": "Takes thickness, kerf and play from the material of the layer when switched on",
     "clearance": "Play",
     "clearance.title": "Total play of a joint: the slot is this much wider than the board (negative = press fit)",
     "kerf": "Kerf",
     "finger": "Finger width",
     "part.lid": "Lid",
     "part.front": "Front",
     "part.back": "Back",
     "part.left": "Left side",
     "part.right": "Right side",
     "part.wall": "Wall {id}",
     "step.box": "Box",
     "step.sizes": "Wall sizes",
     "list.empty": "No inner walls",
     "col.pos": "Position",
     "col.from": "From",
     "col.to": "To",
     "col.pos.title": "Where the wall stands: its centre line, measured from the inside of the back wall (walls from left to right) or of the left wall (walls from back to front)",
     "col.span.title": "Where the wall starts and ends, measured from the inside of the left wall (walls from left to right) or of the back wall (walls from back to front); 0 and the full inner size reach the outer wall",
     "remove.title": "Delete this wall",
     "row.h": "{id} · X",
     "row.v": "{id} · Y",
     "help.select": "Click a wall: select a stretch (Shift: more)",
     "help.whole": "Double click or Ctrl+Shift+click on a wall: the whole wall",
     "help.move": "Drag: move the selection",
     "help.target": "Ctrl on a wall: new wall from the target (click: across the compartment, drag: draw it)",
     "help.free": "Ctrl in an empty space + drag: a free wall",
     "help.end": "Drag an end point: longer or shorter",
     "help.across": "Double click in a compartment: wall from side to side, near the middle in the middle (Shift: from back to front)",
     "help.delete": "Delete: remove the selection",
     "help.context": "Right click: remove a stretch",
     "field.h.a": "Clear behind",
     "field.h.b": "Clear in front",
     "field.v.a": "Clear on the left",
     "field.v.b": "Clear on the right",
     "field.len": "Length",
     "field.len.joined": "Both ends are joined: the length follows the walls they are joined to",
     "plan.start": "Start",
     "move-onto": "Wall {id} cannot lie on wall {id2}.",
     "plan.info.h": "Wall {id} · clear behind {a} mm, in front {b} mm · length {len} mm",
     "plan.info.v": "Wall {id} · clear on the left {a} mm, on the right {b} mm · length {len} mm",
     "plan.info.h.c": "Wall {id} · centred · clear behind {a} mm, in front {b} mm · length {len} mm",
     "plan.info.v.c": "Wall {id} · centred · clear on the left {a} mm, on the right {b} mm · length {len} mm",
     "plan.info.h.w": "Wall {id} · in the middle of wall {wall} · clear behind {a} mm, in front {b} mm · length {len} mm",
     "plan.info.h.b": "Wall {id} · in the middle of the box · clear behind {a} mm, in front {b} mm · length {len} mm",
     "plan.info.v.w": "Wall {id} · in the middle of wall {wall} · clear on the left {a} mm, on the right {b} mm · length {len} mm",
     "plan.info.v.b": "Wall {id} · in the middle of the box · clear on the left {a} mm, on the right {b} mm · length {len} mm",
     "plan.info.h.l": "Wall {id} · in line with wall {wall} · clear behind {a} mm, in front {b} mm · length {len} mm",
     "plan.info.v.l": "Wall {id} · in line with wall {wall} · clear on the left {a} mm, on the right {b} mm · length {len} mm",
     "step.plan": "Plan",
     "view.plan": "From above",
     "edit-no-wall": "Wall {id} does not exist.",
     "add-on-wall": "The new wall would lie on an existing wall.",
     "ask.resize": "The box has inner walls. What should happen to them?",
     "ask.scale": "Grow and shrink with the box",
     "ask.keep": "Keep their distances in mm",
     "material-none": "The layer has no material with a thickness: pick a layer with a material or switch off \"From material\".",
     "material-changed": "The material of the layer ({thickness} mm) no longer matches the box: switch \"From material\" off and on again to take it over.",
     "material-no-kerf": "The material has no calibrated kerf: {kerf} mm is used.",
     "material-no-play": "The material has no calibrated slot play: {play} mm is used.",
     "walls-low": "The inner walls are lower than {min} mm.",
     "info.height": "Height of the inner walls",
     "info.material": "Material",
     "composer-edge-lost": "Internal error: an edge for a joint was not found."
    },
    "de": {
     "name": "Box-Composer",
     "desc": "Kasten mit frei gesetzten Innenwänden: T-Stöße, Ecken, freie Enden und Kreuzungen. Experimentell: bitte die Verbindungen vor einem großen Auftrag zur Probe schneiden.",
     "keys": "Kasten Box Fächer Einsatz Trennwand Sortierkasten",
     "label": "Box-Composer {width} × {depth} × {height}",
     "width": "Breite",
     "depth": "Tiefe",
     "height": "Höhe",
     "thickness": "Materialstärke",
     "walls": "Innenwände",
     "wallsRef": "Innenmaß, in dem die Wände gesetzt wurden",
     "part.floor": "Boden",
     "walls-bad": "Die Wandliste kann nicht gelesen werden.",
     "box-small": "Der Kasten ist zu klein für die Materialstärke.",
     "wall-outside": "Wand {id} liegt außerhalb des Kastens.",
     "wall-on-outer": "Wand {id} liegt auf einer Außenwand.",
     "wall-near-outer": "Wand {id} ist näher als {min} mm an einer Außenwand.",
     "wall-short": "Wand {id} ist kürzer als {min} mm.",
     "walls-close": "Die Wände {id} und {id2} sind näher als {min} mm beieinander.",
     "wall-gap": "Wand {id} endet weniger als {min} mm vor einer Wand, ohne sie zu berühren.",
