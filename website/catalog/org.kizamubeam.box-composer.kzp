    },
    {
     "key": "depth",
     "type": "length",
     "min": 20,
     "max": 2000,
     "def": 200
    },
    {
     "key": "height",
     "type": "length",
     "min": 10,
     "max": 1000,
     "def": 50
    },
    {
     "key": "wallFront",
     "type": "bool",
     "def": true
    },
    {
     "key": "wallBack",
     "type": "bool",
     "def": true
    },
    {
     "key": "wallLeft",
     "type": "bool",
     "def": true
    },
    {
     "key": "wallRight",
     "type": "bool",
     "def": true
    },
    {
     "key": "lid",
     "type": "bool",
     "def": false,
     "showIf": {
      "or": [
       {
