     "def": 0,
     "showIf": {
      "or": [
       {
        "eq": [
         "wallFront",
         true
        ]
       },
       {
        "eq": [
         "wallBack",
         true
        ]
       },
       {
        "eq": [
         "wallLeft",
         true
        ]
