         true
        ]
       },
       {
        "eq": [
         "wallLeft",
         true
        ]
       },
       {
        "eq": [
         "wallRight",
         true
        ]
       }
      ]
     }
    },
    {
     "key": "dividerDrop",
     "type": "length",
     "min": 0,
     "max": 500,
     "def": 0,
     "showIf": {
      "or": [
       {
        "eq": [
         "wallFront",
         true
        ]
       },
       {
        "eq": [
         "wallBack",
         true
        ]
       },
       {
        "eq": [
         "wallLeft",
         true
        ]
       },
