     "material-no-kerf": "El material no tiene kerf calibrado: se usan {kerf} mm.",
     "material-no-play": "El material no tiene holgura de ranura calibrada: se usan {play} mm.",
     "walls-low": "Las paredes interiores miden menos de {min} mm de alto.",
     "info.height": "Alto de las paredes interiores",
     "info.material": "Material",
     "composer-edge-lost": "Error interno: no se encontró una arista para una unión."
    },
    "it": {
     "name": "Compositore di scatole",
     "desc": "Scatola con pareti interne posizionate liberamente: giunti a T, angoli, estremità libere e incroci. Sperimentale: taglia una prova dei giunti prima di un lavoro grande.",
