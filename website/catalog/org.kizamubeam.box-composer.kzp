     "wall-outside": "La pared {id} está fuera de la caja.",
     "wall-on-outer": "La pared {id} está sobre una pared exterior.",
     "wall-near-outer": "La pared {id} está a menos de {min} mm de una pared exterior.",
     "wall-short": "La pared {id} mide menos de {min} mm.",
