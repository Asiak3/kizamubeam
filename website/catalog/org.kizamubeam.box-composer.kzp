   "texts": {
    "en": {
     "name": "Box composer",
     "desc": "Box with freely placed inner walls: T joints, corners, free ends and crossings. Experimental: please test-cut the joints before a large job.",
     "keys": "box divider compartment organizer insert",
     "label": "Box composer {width} × {depth} × {height}",
     "width": "Width",
     "depth": "Depth",
     "height": "Height",
     "thickness": "Material thickness",
     "walls": "Inner walls",
     "wallsRef": "Size the inner walls were placed in",
     "part.floor": "Floor",
     "walls-bad": "The wall list cannot be read.",
     "box-small": "The box is too small for the material thickness.",
     "wall-outside": "Wall {id} lies outside the box.",
     "wall-on-outer": "Wall {id} lies on an outer wall.",
     "wall-near-outer": "Wall {id} is closer than {min} mm to an outer wall.",
     "wall-short": "Wall {id} is shorter than {min} mm.",
     "walls-close": "Walls {id} and {id2} are closer than {min} mm to each other.",
     "wall-gap": "Wall {id} ends less than {min} mm from a wall without touching it.",
     "tees-misaligned": "Walls {id} and {id2} meet the same wall from both sides less than {min} mm apart: line them up or move them further apart.",
     "free-end-short": "The free end of wall {id} is shorter than {min} mm.",
     "info.walls": "Inner walls",
     "wallFront": "Front wall",
     "wallBack": "Back wall",
     "wallLeft": "Left wall",
     "wallRight": "Right wall",
     "lid": "Lid",
     "dividerDrop": "Inner walls lower by",
     "dividerDrop.title": "How much lower the inner walls are than the outer walls",
     "fromMaterial": "From material",
     "fromMaterial.title": "Takes thickness, kerf and play from the material of the layer when switched on",
     "clearance": "Play",
     "clearance.title": "Total play of a joint: the slot is this much wider than the board (negative = press fit)",
     "kerf": "Kerf",
     "finger": "Finger width",
     "part.lid": "Lid",
     "part.front": "Front",
     "part.back": "Back",
     "part.left": "Left side",
     "part.right": "Right side",
     "part.wall": "Wall {id}",
     "material-none": "The layer has no material with a thickness: pick a layer with a material or switch off \"From material\".",
     "material-changed": "The material of the layer ({thickness} mm) no longer matches the box: switch \"From material\" off and on again to take it over.",
     "material-no-kerf": "The material has no calibrated kerf: {kerf} mm is used.",
     "material-no-play": "The material has no calibrated slot play: {play} mm is used.",
     "walls-low": "The inner walls are lower than {min} mm.",
     "info.height": "Height of the inner walls",
     "info.material": "Material",
     "composer-edge-lost": "Internal error: an edge for a joint was not found."
    },
    "de": {
     "name": "Box-Composer",
     "desc": "Kasten mit frei gesetzten Innenwänden: T-Stöße, Ecken, freie Enden und Kreuzungen. Experimentell: bitte die Verbindungen vor einem großen Auftrag zur Probe schneiden.",
     "keys": "Kasten Box Fächer Einsatz Trennwand Sortierkasten",
     "label": "Box-Composer {width} × {depth} × {height}",
