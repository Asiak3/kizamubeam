     "clearance": "Holgura",
     "clearance.title": "Holgura total de una unión: la ranura es esto más ancha que el tablero (negativo = a presión)",
     "kerf": "Kerf",
     "finger": "Ancho de diente",
     "part.lid": "Tapa",
     "part.front": "Frente",
