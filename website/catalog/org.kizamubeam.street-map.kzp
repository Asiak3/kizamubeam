    },
    {
     "id": "overpass",
     "base": "https://overpass-api.de/api",
     "methods": [
      "POST"
     ],
     "types": [
      "json"
     ],
     "rate": 1,
     "purpose": "net.overpass",
     "attribution": "© OpenStreetMap contributors"
    },
    {
     "id": "overpassCoffee",
     "base": "https://overpass.private.coffee/api",
     "methods": [
      "POST"
     ],
     "types": [
      "json"
     ],
     "rate": 1,
     "purpose": "net.overpassCoffee",
     "attribution": "© OpenStreetMap contributors"
    },
    {
     "id": "overpassDresel",
     "base": "https://ovp.dresel.systems/api",
     "methods": [
      "POST"
     ],
     "types": [
      "json"
     ],
     "rate": 1,
     "purpose": "net.overpassDresel",
     "attribution": "© OpenStreetMap contributors"
    }
   ],
   "params": [
    {
     "key": "query",
     "type": "text",
     "def": ""
    },
    {
     "key": "center",
     "type": "data",
     "def": "52.516275,13.377704"
    },
    {
     "key": "placeName",
     "type": "data",
     "def": "Brandenburger Tor, Berlin"
    },
    {
     "key": "shape",
     "type": "enum",
     "options": [
      [
       "rect",
       "shape.rect"
      ],
      [
       "circle",
       "shape.circle"
      ]
     ],
     "def": "rect"
    },
    {
     "key": "width",
     "type": "length",
     "min": 30,
     "max": 600,
     "def": 150
    },
    {
     "key": "height",
     "type": "length",
     "min": 30,
     "max": 600,
     "def": 150,
     "showIf": {
      "eq": [
       "shape",
       "rect"
      ]
     }
    },
    {
     "key": "span",
     "type": "number",
     "min": 200,
     "max": 4000,
     "def": 800
    },
    {
     "key": "roads",
     "type": "enum",
     "options": [
      [
       "none",
       "roads.none"
      ],
      [
       "major",
       "roads.major"
      ],
      [
       "streets",
       "roads.streets"
      ],
      [
       "all",
       "roads.all"
      ]
     ],
     "def": "streets"
    },
    {
     "key": "roadStyle",
     "type": "enum",
     "options": [
      [
       "bands",
       "roadStyle.bands"
      ],
      [
       "lines",
       "roadStyle.lines"
      ]
     ],
     "def": "bands"
    },
    {
     "key": "roadWidth",
     "type": "length",
     "min": 0.2,
     "max": 6,
     "def": 1.6,
     "showIf": {
      "eq": [
       "roadStyle",
       "bands"
      ]
     }
    },
    {
     "key": "water",
     "type": "bool",
     "def": true
    },
    {
     "key": "rail",
     "type": "bool",
     "def": true
    },
    {
     "key": "parks",
     "type": "bool",
     "def": false
    },
    {
     "key": "buildings",
     "type": "bool",
     "def": false
    },
    {
     "key": "invert",
     "type": "bool",
     "def": false,
     "showIf": {
      "eq": [
       "roadStyle",
       "bands"
      ]
     }
    },
    {
     "key": "minArea",
     "type": "number",
     "min": 0,
     "max": 20,
     "def": 0.3,
     "advanced": true
    }
   ],
   "dialog": {
    "version": 5,
    "actions": [
     {
      "id": "find",
      "label": "find",
      "title": "find.title"
     }
