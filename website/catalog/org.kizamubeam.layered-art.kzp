{
 "format": "kizamubeam-pack",
 "formatVersion": 2,
 "id": "org.kizamubeam.layered-art",
 "version": "1.0.0",
 "name": {
  "en": "Layered art",
  "de": "Schichtbild",
  "it": "Arte a strati"
 },
 "description": {
  "en": "Turns a logo, drawing or photo into stacked plates that are cut and glued on top of each other for depth.",
  "de": "Macht aus einem Logo, einer Zeichnung oder einem Foto gestapelte Platten, die geschnitten und für Tiefe übereinander geklebt werden.",
  "it": "Trasforma un logo, un disegno o una foto in pannelli sovrapposti, tagliati e incollati uno sull'altro per dare profondità."
 },
