   "dialog": {
    "version": 1
   },
   "preview": {
    "center": true
   },
   "params": [
    {
     "key": "width",
     "type": "length",
     "min": 30,
     "max": 1500,
     "def": 200
    },
    {
     "key": "height",
     "type": "length",
     "min": 30,
     "max": 1500,
     "def": 150
    },
    {
     "key": "cols",
     "type": "int",
     "min": 2,
     "max": 50,
     "def": 6
    },
    {
     "key": "rows",
     "type": "int",
     "min": 2,
     "max": 50,
     "def": 4
    },
    {
     "key": "seed",
     "type": "int",
     "min": 1,
     "max": 99999,
     "def": 1
    },
    {
     "key": "shape",
     "type": "enum",
     "options": [
      [
       "classic",
       "shape.classic"
      ],
      [
       "round",
       "shape.round"
      ],
      [
       "square",
       "shape.square"
      ]
     ],
     "def": "classic"
    },
    {
     "key": "tab",
     "type": "number",
     "min": 10,
     "max": 35,
     "def": 22,
     "section": "section.tabs"
    },
    {
     "key": "jitter",
     "type": "number",
     "min": 0,
     "max": 100,
     "def": 50,
     "section": "section.tabs"
    },
    {
     "key": "corner",
     "type": "length",
     "min": 0,
     "max": 100,
     "def": 0,
     "section": "section.edge"
    },
    {
     "key": "frame",
     "type": "bool",
     "def": false,
     "section": "section.edge"
    },
    {
     "key": "frameWidth",
     "type": "length",
     "min": 3,
     "max": 100,
     "def": 15,
     "section": "section.edge",
     "showIf": {
      "eq": [
       "frame",
       true
      ]
     }
    },
    {
     "key": "numbers",
     "type": "bool",
     "def": false,
     "section": "section.numbers"
    },
    {
     "key": "numberSize",
     "type": "length",
     "min": 1.5,
     "max": 30,
     "def": 4,
     "section": "section.numbers",
     "showIf": {
      "eq": [
       "numbers",
       true
      ]
     }
    }
   ],
