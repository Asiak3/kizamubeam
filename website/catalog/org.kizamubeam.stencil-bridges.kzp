 "id": "org.kizamubeam.stencil-bridges",
 "version": "1.0.0",
 "name": {
  "en": "Stencil bridges",
  "de": "Schablonenstege",
  "it": "Ponti per stencil",
  "es": "Puentes para plantillas",
  "pt-BR": "Pontes para estêncil"
 },
 "description": {
  "en": "Bridges for the inner parts of letters and shapes, so they do not fall out of a stencil.",
  "de": "Stege für die Innenteile von Buchstaben und Formen, damit sie nicht aus der Schablone fallen.",
  "it": "Ponti per le parti interne di lettere e forme, così non cadono dallo stencil.",
  "es": "Puentes para las partes interiores de letras y formas, para que no se caigan de la plantilla.",
  "pt-BR": "Pontes para as partes internas de letras e formas, para que não caiam do estêncil."
 },
 "author": "KizamuBeam",
 "homepage": "https://github.com/KizamuBeam/kizamubeam/tree/main/plugins/stencil-bridges",
