   "dialog": {
    "version": 1
   },
   "params": [
    {
     "key": "width",
     "type": "length",
     "min": 0.2,
     "max": 20,
     "def": 2,
     "title": "width.title"
    },
    {
     "key": "count",
     "type": "enum",
     "options": [
      [
       "1",
       "count.1"
      ],
      [
       "2",
       "count.2"
      ],
      [
       "auto",
       "count.auto"
      ]
     ],
     "def": "auto"
    },
    {
     "key": "autoSize",
     "type": "length",
     "min": 1,
     "max": 1000,
     "def": 25,
     "title": "autoSize.title",
     "showIf": {
      "eq": [
       "count",
       "auto"
      ]
     }
    },
    {
     "key": "direction",
     "type": "enum",
     "options": [
      [
       "vertical",
       "direction.vertical"
      ],
      [
       "horizontal",
       "direction.horizontal"
      ],
      [
       "shortest",
       "direction.shortest"
      ]
     ],
     "def": "vertical"
    },
    {
     "key": "nested",
     "type": "bool",
     "def": true,
     "title": "nested.title"
    },
    {
     "key": "minArea",
     "type": "number",
     "min": 0,
     "max": 10000,
     "def": 0.5,
     "title": "minArea.title",
     "advanced": true
    }
   ],
