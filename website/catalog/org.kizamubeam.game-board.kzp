     "max": 30,
     "def": 8
    },
    {
     "key": "rows",
     "type": "int",
     "min": 2,
     "max": 30,
     "def": 8
    },
    {
     "key": "size",
     "type": "length",
     "min": 40,
     "max": 1500,
     "def": 320
    },
    {
     "key": "sizeIncludesBorder",
     "type": "bool",
     "def": false
    },
    {
     "key": "style",
     "type": "enum",
     "options": [
      [
       "fill",
       "style.fill"
      ],
      [
       "hatch",
       "style.hatch"
      ],
      [
       "crosshatch",
