       "straight"
      ]
     }
    },
    {
     "key": "radius",
     "type": "length",
     "min": 15,
     "max": 500,
     "def": 60,
     "showIf": {
      "ne": [
       "type",
       "straight"
      ]
     }
    },
    {
     "key": "sweep",
     "type": "angle",
     "min": 10,
     "max": 360,
     "def": 180,
     "showIf": {
      "ne": [
       "type",
       "straight"
      ]
     }
    },
    {
     "key": "divisions",
     "type": "int",
     "min": 1,
     "max": 100,
