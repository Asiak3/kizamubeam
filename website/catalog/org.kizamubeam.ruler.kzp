         "straight"
        ]
       },
       {
        "eq": [
         "units",
         "metric"
        ]
       }
      ]
     }
    },
    {
     "key": "inches",
     "type": "int",
     "min": 1,
     "max": 72,
     "def": 6,
     "showIf": {
      "and": [
       {
        "eq": [
         "type",
         "straight"
        ]
       },
       {
        "eq": [
         "units",
         "inch"
        ]
       }
      ]
     }
    },
