     "type": "int",
     "min": 1,
     "max": 20,
     "def": 5,
     "showIf": {
      "eq": [
       "type",
       "dial"
      ]
     }
    },
    {
     "key": "startValue",
     "type": "number",
     "min": -10000,
     "max": 10000,
     "def": 0,
     "showIf": {
      "ne": [
