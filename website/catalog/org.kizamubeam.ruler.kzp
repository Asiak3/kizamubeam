       {
        "eq": [
         "type",
         "straight"
        ]
       },
       {
        "eq": [
         "units",
         "inch"
        ]
       }
      ]
     }
    },
    {
     "key": "width",
     "type": "length",
     "min": 8,
     "max": 200,
     "def": 30,
     "showIf": {
      "eq": [
