{
  "format": "kizamubeam-pack",
  "formatVersion": 2,
  "id": "org.kizamubeam.ruler",
  "version": "1.0.0",
  "name": {
    "en": "Rulers and scales",
    "de": "Lineale und Skalen",
    "it": "Righelli e scale",
    "es": "Reglas y escalas",
    "pt-BR": "Réguas e escalas"
  },
  "description": {
    "en": "Straight rulers (metric or inch), protractors and scale dials with engraved ticks and numbers at their exact positions.",
    "de": "Gerade Lineale (metrisch oder Zoll), Winkelmesser und Skalenscheiben mit gravierten Strichen und Zahlen an den genauen Positionen.",
    "it": "Righelli dritti (metrici o in pollici), goniometri e quadranti con tacche e numeri incisi nelle posizioni esatte."
  },
  "author": "KizamuBeam",
  "homepage": "https://github.com/KizamuBeam/kizamubeam/tree/main/plugins/ruler",
  "build": [
    {
      "esbuild": "src/index.ts",
      "out": "dist/ruler.js"
    }
  ],
  "plugins": [
    {
      "id": "org.kizamubeam.ruler",
      "type": "generator",
      "api": 1,
      "version": 1,
      "kind": "part",
      "runtime": "js",
      "code": "@dist/ruler.js",
      "icon": "measure",
      "dialog": {
        "version": 1
      },
      "preview": {
        "center": true
      },
      "params": [
        {
          "key": "type",
          "type": "enum",
          "options": [
            [
              "straight",
              "type.straight"
            ],
            [
              "protractor",
              "type.protractor"
            ],
            [
              "dial",
              "type.dial"
            ]
          ],
          "def": "straight"
        },
        {
          "key": "units",
          "type": "enum",
          "options": [
            [
              "metric",
              "units.metric"
            ],
            [
              "inch",
              "units.inch"
            ]
          ],
          "def": "metric",
          "showIf": {
            "eq": [
              "type",
              "straight"
            ]
          }
        },
        {
          "key": "length",
          "type": "length",
          "min": 20,
          "max": 2000,
          "def": 150,
          "showIf": {
            "and": [
              {
                "eq": [
                  "type",
                  "straight"
                ]
              },
              {
                "eq": [
                  "units",
                  "metric"
                ]
              }
            ]
          }
        },
        {
          "key": "inches",
          "type": "int",
          "min": 1,
          "max": 72,
          "def": 6,
          "showIf": {
            "and": [
              {
                "eq": [
                  "type",
                  "straight"
                ]
              },
              {
                "eq": [
                  "units",
                  "inch"
                ]
              }
            ]
          }
        },
        {
          "key": "sub",
          "type": "enum",
          "options": [
            [
              "2",
              "sub.2"
            ],
            [
              "4",
              "sub.4"
            ],
            [
              "8",
              "sub.8"
            ],
            [
              "16",
              "sub.16"
            ]
          ],
          "def": "16",
          "showIf": {
            "and": [
              {
                "eq": [
                  "type",
                  "straight"
                ]
              },
              {
                "eq": [
                  "units",
                  "inch"
                ]
              }
            ]
          }
        },
        {
          "key": "width",
          "type": "length",
          "min": 8,
          "max": 200,
          "def": 30,
          "showIf": {
            "eq": [
              "type",
              "straight"
            ]
          }
        },
        {
          "key": "radius",
          "type": "length",
          "min": 15,
          "max": 500,
          "def": 60,
          "showIf": {
            "ne": [
              "type",
              "straight"
            ]
          }
        },
        {
          "key": "sweep",
          "type": "angle",
          "min": 10,
          "max": 360,
          "def": 180,
          "showIf": {
            "ne": [
              "type",
              "straight"
            ]
          }
        },
        {
          "key": "divisions",
          "type": "int",
          "min": 1,
          "max": 100,
          "def": 10,
          "showIf": {
            "eq": [
              "type",
              "dial"
            ]
          }
        },
        {
          "key": "minorPer",
          "type": "int",
          "min": 1,
          "max": 20,
          "def": 5,
          "showIf": {
            "eq": [
              "type",
              "dial"
            ]
          }
        },
        {
          "key": "startValue",
          "type": "number",
          "min": -10000,
          "max": 10000,
          "def": 0,
          "showIf": {
            "ne": [
              "type",
              "protractor"
            ]
          }
        },
        {
          "key": "step",
          "type": "number",
          "min": -1000,
          "max": 1000,
          "def": 1,
          "showIf": {
            "ne": [
              "type",
              "protractor"
            ]
          }
        },
        {
          "key": "major",
          "type": "length",
          "min": 1,
          "max": 60,
          "def": 8,
          "section": "section.ticks"
        },
        {
          "key": "half",
          "type": "length",
          "min": 0.5,
          "max": 60,
          "def": 6,
          "section": "section.ticks"
        },
        {
          "key": "minor",
          "type": "length",
          "min": 0.5,
          "max": 60,
          "def": 4,
          "section": "section.ticks"
        },
        {
          "key": "numbers",
          "type": "bool",
          "def": true,
          "section": "section.numbers"
        },
        {
          "key": "numberSize",
          "type": "length",
          "min": 1.5,
          "max": 40,
          "def": 4,
          "section": "section.numbers",
          "showIf": {
            "eq": [
              "numbers",
              true
            ]
          }
        },
        {
          "key": "numberEvery",
          "type": "int",
          "min": 1,
          "max": 20,
          "def": 1,
          "section": "section.numbers",
          "showIf": {
            "eq": [
              "numbers",
              true
            ]
          }
        },
        {
          "key": "rotate",
          "type": "bool",
          "def": true,
          "section": "section.numbers",
          "showIf": {
            "and": [
              {
                "eq": [
                  "numbers",
                  true
                ]
              },
              {
                "ne": [
                  "type",
                  "straight"
                ]
              }
            ]
          }
        },
        {
          "key": "labels",
          "type": "text",
          "def": "",
          "section": "section.numbers",
          "showIf": {
            "eq": [
              "numbers",
              true
            ]
          }
        },
        {
          "key": "unitText",
          "type": "bool",
          "def": true,
          "section": "section.numbers",
          "showIf": {
            "eq": [
              "type",
              "straight"
            ]
          }
        },
        {
          "key": "margin",
          "type": "length",
          "min": 2,
          "max": 50,
          "def": 5,
          "section": "section.body"
        },
        {
          "key": "corner",
          "type": "length",
          "min": 0,
          "max": 50,
          "def": 3,
          "section": "section.body",
          "showIf": {
            "eq": [
              "type",
              "straight"
            ]
          }
        },
        {
          "key": "hole",
          "type": "bool",
          "def": true,
          "section": "section.body"
        },
        {
          "key": "holeDia",
          "type": "length",
          "min": 1,
          "max": 100,
          "def": 6,
          "section": "section.body",
          "showIf": {
            "eq": [
              "hole",
              true
            ]
          }
        }
      ],
      "texts": {
