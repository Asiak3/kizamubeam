{
  "format": "kizamubeam-pack",
  "formatVersion": 2,
  "id": "org.kizamubeam.street-map",
  "version": "1.0.0",
  "name": {
    "en": "Street map",
    "de": "Stadtplan",
    "it": "Mappa stradale"
  },
  "description": {
    "en": "Engravable map of a place from OpenStreetMap: roads, water, railways, parks and buildings on a cut plate.",
    "de": "Gravierbarer Plan eines Ortes aus OpenStreetMap: Straßen, Wasser, Bahnen, Parks und Gebäude auf einer geschnittenen Platte.",
    "it": "Mappa incidibile di un luogo da OpenStreetMap: strade, acqua, ferrovie, parchi ed edifici su una lastra tagliata."
  },
  "author": "KizamuBeam",
  "homepage": "https://github.com/KizamuBeam/kizamubeam/tree/main/plugins/street-map",
  "build": [
    {
      "esbuild": "src/index.ts",
      "out": "dist/street-map.js"
    }
  ],
  "plugins": [
    {
      "id": "org.kizamubeam.street-map",
      "type": "generator",
      "api": 1,
      "version": 1,
      "kind": "part",
      "runtime": "js",
      "code": "@dist/street-map.js",
      "icon": "target",
      "host": [
        "fetch",
        "region"
      ],
      "preview": {
        "center": true
      },
      "network": [
        {
          "id": "nominatim",
          "base": "https://nominatim.openstreetmap.org",
          "methods": [
            "GET"
          ],
          "types": [
            "json"
          ],
          "rate": 1,
          "purpose": "net.nominatim",
          "attribution": "© OpenStreetMap contributors"
        },
        {
          "id": "overpass",
          "base": "https://overpass-api.de/api",
          "methods": [
            "POST"
          ],
          "types": [
            "json"
          ],
          "rate": 1,
          "purpose": "net.overpass",
          "attribution": "© OpenStreetMap contributors"
        }
      ],
      "params": [
        {
          "key": "query",
          "type": "text",
          "def": ""
        },
        {
          "key": "center",
          "type": "data",
          "def": "52.516275,13.377704"
        },
        {
          "key": "placeName",
          "type": "data",
          "def": "Brandenburger Tor, Berlin"
        },
        {
          "key": "shape",
          "type": "enum",
          "options": [
            [
              "rect",
              "shape.rect"
            ],
            [
              "circle",
              "shape.circle"
            ]
          ],
          "def": "rect"
        },
        {
          "key": "width",
          "type": "length",
          "min": 30,
          "max": 600,
          "def": 150
        },
        {
          "key": "height",
          "type": "length",
          "min": 30,
          "max": 600,
          "def": 150,
          "showIf": {
            "eq": [
              "shape",
              "rect"
            ]
          }
        },
        {
          "key": "span",
          "type": "number",
          "min": 200,
          "max": 4000,
          "def": 800
        },
        {
          "key": "roads",
          "type": "enum",
          "options": [
            [
              "none",
              "roads.none"
            ],
            [
              "major",
              "roads.major"
            ],
            [
              "streets",
              "roads.streets"
            ],
            [
              "all",
              "roads.all"
            ]
          ],
          "def": "streets"
        },
        {
          "key": "roadStyle",
          "type": "enum",
          "options": [
            [
              "bands",
              "roadStyle.bands"
            ],
            [
              "lines",
              "roadStyle.lines"
            ]
          ],
          "def": "bands"
        },
        {
          "key": "roadWidth",
          "type": "length",
          "min": 0.2,
          "max": 6,
          "def": 1.6,
          "showIf": {
            "eq": [
              "roadStyle",
              "bands"
            ]
          }
        },
        {
          "key": "water",
          "type": "bool",
          "def": true
        },
        {
          "key": "rail",
          "type": "bool",
          "def": true
        },
        {
          "key": "parks",
          "type": "bool",
          "def": false
        },
        {
          "key": "buildings",
          "type": "bool",
          "def": false
        },
        {
          "key": "invert",
          "type": "bool",
          "def": false,
          "showIf": {
            "eq": [
              "roadStyle",
              "bands"
            ]
          }
        },
        {
          "key": "minArea",
          "type": "number",
          "min": 0,
          "max": 20,
          "def": 0.3,
          "advanced": true
        }
      ],
      "dialog": {
        "version": 5,
        "actions": [
          {
            "id": "find",
            "label": "find",
            "title": "find.title"
          }
        ],
        "steps": [
          {
            "id": "place",
            "label": "step.place",
            "items": [
              "query",
              "find"
            ]
          },
          {
            "id": "size",
            "label": "step.size",
            "items": [
              "shape",
              "width",
              "height",
              "span"
            ]
          },
          {
            "id": "content",
            "label": "step.content",
            "items": [
              "roads",
              "roadStyle",
              "roadWidth",
              "water",
              "rail",
              "parks",
              "buildings",
              "invert",
              "minArea"
            ]
          }
        ]
      },
      "texts": {
